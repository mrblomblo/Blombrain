{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blombrain",
  "version": "0.1.0",
  "identifier": "app.blombrain.desktop",
  "build": {
    "beforeDevCommand": "node scripts/dev-desktop.mjs",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:frontend && npm run build:backend && npm run build:sidecar",
    "frontendDist": "./splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/blombrain-backend"],
    "resources": [
      "resources/native/*",
      "resources/frontend/**/*",
      "resources/LICENSES.md"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}

{
  "name": "blombrain-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Blombrain backend: owns persistence, MCP process management, and proxies inference. The frontend never talks to inference/MCP backends directly.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}

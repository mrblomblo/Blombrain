{
  "name": "blombrain-backend",
  "engines": {
    "node": "^24.0.0"
  },
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Blombrain backend: owns persistence, MCP process management, and proxies inference. The frontend never talks to inference/MCP backends directly.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
